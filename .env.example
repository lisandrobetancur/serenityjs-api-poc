# Copy this file to .env and adjust the values. Every value is optional.

# Environment block of src/utils/config/environments.ts (qa uses "default"; unknown names fall back to "default")
ENVIRONMENT=qa

# API under test
API_BASE_URL=http://localhost:8000
API_KEY=test-api-key-123

# Database credentials. Without DB_HOST, they are read from the environment's Secrets Manager secret.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=

# AWS (leave AWS_ENDPOINT empty for real AWS; http://localhost:4566 for LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT=

# Behaviour
# true: @database / @localstack scenarios fail instead of being skipped
REQUIRE_SERVICES=false
# Maximum number of shards in npm run test:parallel
PARALLEL_WORKERS=4
MARKET_OPEN_HOURS=09:30-16:00
LOG_LEVEL=debug
DEFAULT_ACTOR=Tester
