{
  "name": "serenityjs-api-poc",
  "version": "1.0.0",
  "description": "API test suite for the Prop Room API with Serenity/JS, the Screenplay Pattern and Cucumber",
  "private": true,
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf target/site/serenity target/logs target/downloads target/locks target/*.env target/*.tsv target/*.json",
    "pretest": "npm run clean && npm run typecheck && npm run check",
    "test": "tsx scripts/run-tests.ts",
    "pretest:parallel": "npm run pretest",
    "test:parallel": "tsx scripts/run-tests.ts --parallel",
    "test:dry": "tsx scripts/run-tests.ts --dry-run",
    "test:smoke": "TAGS=\"@smoke\" npm test",
    "test:fast": "TAGS=\"not @slow\" npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "check": "npm run check:sql && npm run check:scenario-ids && npm run check:test-data && npm run check:shared-state",
    "check:sql": "tsx scripts/check-native-query-safety.ts && tsx scripts/check-native-query-safety.ts --self-test",
    "check:scenario-ids": "tsx scripts/sync-scenario-ids.ts",
    "check:test-data": "tsx scripts/check-test-data.ts",
    "check:shared-state": "tsx scripts/check-shared-state.ts",
    "sync:scenario-ids": "tsx scripts/sync-scenario-ids.ts --write",
    "report": "tsx scripts/set-report-context.ts && serenity-bdd run --features ./features",
    "report:open": "tsx scripts/open-report.ts",
    "summary": "tsx scripts/test-summary.ts",
    "results": "tsx scripts/run-results.ts",
    "scenarios:csv": "tsx scripts/export-scenarios-csv.ts",
    "fake-api": "tsx scripts/fake-api.ts",
    "db:setup": "tsx scripts/setup-local-db.ts",
    "serenity:update": "serenity-bdd update",
    "generate:types": "npx --yes openapi-typescript@7.13.0 ${API_BASE_URL:-http://localhost:8000}/openapi.json --default-non-nullable false -o src/models/schema.d.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@cucumber/tag-expressions": "^11.0.1",
    "@eslint/js": "^10.0.1",
    "@serenity-js/assertions": "^3.49.0",
    "@serenity-js/console-reporter": "^3.49.0",
    "@serenity-js/core": "^3.49.0",
    "@serenity-js/cucumber": "^3.49.0",
    "@serenity-js/rest": "^3.49.0",
    "@serenity-js/serenity-bdd": "^3.49.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-ecs": "^3.1164.0",
    "@aws-sdk/client-lambda": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-secrets-manager": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "proper-lockfile": "^4.1.2"
  }
}
